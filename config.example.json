{
  "git_repo_path": "C:/path/to/your/repository",
  "server": {
    "command": "python",
    "args": ["mcp_server.py"]
  },
  "client": {
    "interactive": true
  },
  "weather": {
    "provider": "open-meteo",
    "api_key_required": false
  },
  "llm": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "api_key_env": "DEEPSEEK_API_KEY"
  },
  "scheduler": {
    "db_path": "scheduler.db",
    "db_path_env": "SCHEDULER_DB_PATH"
  },
  "pipelines": {
    "config_file": "pipelines.json",
    "reports_dir": "reports"
  }
}

